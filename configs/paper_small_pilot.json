{
  "tokenizer": {
    "output_dir": "data/tokenizers/research_papers_bpe32k",
    "name": "research-papers-bpe32k",
    "model_type": "bpe",
    "vocab_size": 32000,
    "max_records_per_source": 50000
  },
  "preprocess": {
    "tokenizer": "data/tokenizers/research_papers_bpe32k",
    "output_dir": "data/processed/papers_pilot",
    "max_records_per_source": 15000,
    "source_weights": "dblp=1.0,arxiv=0.9",
    "shuffle_buckets": 64,
    "shard_size_tokens": 1000000,
    "buffer_tokens": 100000
  },
  "training": {
    "train_bin": "data/processed/papers_pilot/train.manifest.json",
    "val_bin": "data/processed/papers_pilot/val.manifest.json",
    "out_dir": "checkpoints/papers_pilot",
    "model_size": "small",
    "context_length": 128,
    "micro_batch_size": 4,
    "grad_accum_steps": 4,
    "max_steps": 120,
    "warmup_steps": 20,
    "max_lr": 0.0003,
    "min_lr": 3e-05,
    "eval_interval": 30,
    "eval_steps": 10,
    "checkpoint_interval": 30,
    "keep_last_n_checkpoints": 3,
    "sample_prompt_suite": "research_capability",
    "sample_count": 3,
    "sample_max_new_tokens": 80
  },
  "evaluation": {
    "val_bin": "data/processed/papers_pilot/val.manifest.json",
    "test_bin": "data/processed/papers_pilot/test.manifest.json",
    "prompt_suite": "research_capability",
    "output_dir": "evaluation/results/papers_pilot",
    "batch_size": 4
  }
}
