{
  "tokenizer": {
    "output_dir": "data/tokenizers/research_papers_bpe32k",
    "name": "research-papers-bpe32k",
    "model_type": "bpe",
    "vocab_size": 32000,
    "max_records_per_source": 500000
  },
  "preprocess": {
    "tokenizer": "data/tokenizers/research_papers_bpe32k",
    "output_dir": "data/processed/papers_large",
    "source_weights": "dblp=1.0,arxiv=0.9",
    "shuffle_buckets": 512,
    "shard_size_tokens": 50000000,
    "buffer_tokens": 1000000
  },
  "training": {
    "train_bin": "data/processed/papers_large/train.manifest.json",
    "val_bin": "data/processed/papers_large/val.manifest.json",
    "out_dir": "checkpoints/papers_large",
    "model_size": "large",
    "micro_batch_size": 4,
    "grad_accum_steps": 8,
    "max_steps": 100000,
    "warmup_steps": 4000,
    "max_lr": 0.0004,
    "min_lr": 4e-05,
    "dtype": "bf16",
    "gradient_checkpointing": true,
    "eval_interval": 500,
    "eval_steps": 50,
    "checkpoint_interval": 1000,
    "keep_last_n_checkpoints": 6,
    "sample_prompt_suite": "research_capability",
    "sample_count": 4,
    "sample_max_new_tokens": 120
  },
  "evaluation": {
    "val_bin": "data/processed/papers_large/val.manifest.json",
    "test_bin": "data/processed/papers_large/test.manifest.json",
    "prompt_suite": "research_capability",
    "output_dir": "evaluation/results/papers_large",
    "batch_size": 8
  }
}
